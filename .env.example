# Copy this file to .env and fill in your own values. Never commit .env.
# Request a key at https://www.transitchicago.com/developers/traintrackerapply/

# Required for live collection (not needed for --sample mode).
CTA_API_KEY=your-cta-train-tracker-key-here

# Comma-separated CTA parent station IDs (mapid, 4xxxx range).
# 41320 = Belmont (Red, Brn, P), 40380 = Clark/Lake (Blue, Brn, G, Org, P, Pink), 40900 = Howard (Red, P, Y).
# Together these three cover all 8 CTA 'L' lines.
CTA_STATION_IDS=41320,40380,40900

# Seconds between polling cycles in a bounded session. Minimum enforced: 30.
CTA_POLL_INTERVAL_SECONDS=60

# Per-request HTTP timeout in seconds.
CTA_REQUEST_TIMEOUT_SECONDS=10

# Total attempts per request for transient failures (network errors, HTTP 5xx, CTA errCd 900).
CTA_MAX_ATTEMPTS=3

# Where raw JSON observations are written (relative to the repo root or absolute).
CTA_RAW_DATA_DIR=data/raw

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Databricks (Phase 2: uploading raw files) ------------------------------
# Workspace URL, e.g. https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=
# Personal access token: Settings > Developer > Access tokens. Keep it secret.
DATABRICKS_TOKEN=
# Unity Catalog location for raw files: /Volumes/<catalog>/<schema>/<volume>
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=cta_bronze
DATABRICKS_LANDING_VOLUME=landing
