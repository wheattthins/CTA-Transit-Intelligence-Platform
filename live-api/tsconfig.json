{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    // Vercel compiles through a temp tsconfig in /tmp that extends this one; an explicit typeRoots
    // (resolved relative to this file) keeps @types/node findable from there.
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"]
  },
  "include": ["api"]
}
